{
    "name": "LS_AzureSqlDatabase",
    "type": "Microsoft.DataFactory/factories/linkedServices",
    "properties": {
        "annotations": [],
        "type": "AzureSqlDatabase",
        "typeProperties": {
            "connectionString": "Data Source=tcp:<your-sql-server-name>.database.windows.net,1433;Initial Catalog=<your-database-name>;",
            "userName": "<your-sql-admin-user>",
            "password": {
                "type": "SecureString",
                "value": "<use Azure Key Vault reference here - never commit real credentials>"
            }
        },
        "connectVia": {
            "referenceName": "AutoResolveIntegrationRuntime",
            "type": "IntegrationRuntimeReference"
        }
    }
}
